# Production Terraform Environment Variables
# Copy to .env.terraform.prod and source before running terraform:
#   source .env.terraform.prod && terraform apply

# =============================================================================
# Keycloak Connection (Required - set to your production Keycloak)
# =============================================================================
export TF_VAR_keycloak_url="https://auth.yourdomain.com"
export TF_VAR_keycloak_admin_user="admin"
export TF_VAR_keycloak_admin_password=""  # Set this securely!

# =============================================================================
# Environment
# =============================================================================
export TF_VAR_environment="prod"
export TF_VAR_ssl_required="all"  # Require SSL for all connections

# =============================================================================
# Client Secrets (Generate with: openssl rand -base64 32)
# =============================================================================
export TF_VAR_fen_api_client_secret=""  # Generate a strong secret!

# =============================================================================
# API Client Configuration - Set to your production domains
# =============================================================================
export TF_VAR_api_redirect_uris='["https://api.yourdomain.com/*"]'
export TF_VAR_api_web_origins='["https://api.yourdomain.com"]'

# =============================================================================
# Web Client Configuration - Set to your production frontend domains
# =============================================================================
export TF_VAR_web_redirect_uris='["https://app.yourdomain.com/*"]'
export TF_VAR_web_origins='["https://app.yourdomain.com"]'

# =============================================================================
# Test Users - DISABLED in production
# =============================================================================
export TF_VAR_create_test_users="false"
# Passwords not needed when create_test_users=false
