      "id": 1,
      "panels": [],
      "title": "Shard Overview",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [{"options": {"0": {"color": "red", "text": "Down"}, "1": {"color": "green", "text": "Up"}}, "type": "value"}],
          "thresholds": {"mode": "absolute", "steps": [{"color": "red"}, {"color": "green", "value": 1}]}
        }
      },
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 1},
      "id": 2,
      "options": {"colorMode": "background", "graphMode": "none", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "targets": [{"expr": "fen_shard_health{namespace=\"$namespace\"}", "legendFormat": "Shard {{shard_id}}", "refId": "A"}],
      "title": "Shard Health",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 9},
      "id": 3,
      "panels": [],
      "title": "Storage",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"drawStyle": "line", "fillOpacity": 10},
          "unit": "bytes"
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 10},
      "id": 4,
      "options": {"legend": {"displayMode": "table", "placement": "right"}},
      "targets": [{"expr": "sum(fen_shard_storage_bytes{namespace=\"$namespace\"}) by (shard_id)", "legendFormat": "Shard {{shard_id}}", "refId": "A"}],
      "title": "Storage by Shard",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"drawStyle": "line", "fillOpacity": 10},
          "unit": "short"
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 10},
      "id": 5,
      "options": {"legend": {"displayMode": "table", "placement": "right"}},
      "targets": [{"expr": "sum(fen_shard_document_count{namespace=\"$namespace\"}) by (shard_id)", "legendFormat": "Shard {{shard_id}}", "refId": "A"}],
      "title": "Documents by Shard",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 18},
      "id": 6,
      "panels": [],
      "title": "Performance",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"drawStyle": "line", "fillOpacity": 10},
          "unit": "ops"
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 19},
      "id": 7,
      "options": {"legend": {"displayMode": "table", "placement": "right"}},
      "targets": [
        {"expr": "sum(rate(fen_shard_reads_total{namespace=\"$namespace\"}[5m])) by (shard_id)", "legendFormat": "Reads - Shard {{shard_id}}", "refId": "A"},
        {"expr": "sum(rate(fen_shard_writes_total{namespace=\"$namespace\"}[5m])) by (shard_id)", "legendFormat": "Writes - Shard {{shard_id}}", "refId": "B"}
      ],
      "title": "Read/Write Throughput",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"drawStyle": "line", "fillOpacity": 10},
          "unit": "s"
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 19},
      "id": 8,
      "options": {"legend": {"displayMode": "table", "placement": "right"}},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum(rate(fen_shard_read_latency_seconds_bucket{namespace=\"$namespace\"}[5m])) by (le, shard_id))", "legendFormat": "p50 - Shard {{shard_id}}", "refId": "A"},
        {"expr": "histogram_quantile(0.99, sum(rate(fen_shard_read_latency_seconds_bucket{namespace=\"$namespace\"}[5m])) by (le, shard_id))", "legendFormat": "p99 - Shard {{shard_id}}", "refId": "B"}
      ],
      "title": "Read Latency",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 27},
      "id": 9,
      "panels": [],
      "title": "Replication",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"drawStyle": "line", "fillOpacity": 10},
          "unit": "short"
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 28},
      "id": 10,
      "options": {"legend": {"displayMode": "table", "placement": "right"}},
      "targets": [{"expr": "fen_shard_replica_lag{namespace=\"$namespace\"}", "legendFormat": "Shard {{shard_id}} Replica {{replica_id}}", "refId": "A"}],
      "title": "Replica Lag",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "thresholds": {"mode": "absolute", "steps": [{"color": "green"}, {"color": "yellow", "value": 1}, {"color": "red", "value": 5}]}
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 28},
      "id": 11,
      "options": {"colorMode": "value", "graphMode": "area", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "targets": [{"expr": "sum(fen_shard_rebalancing{namespace=\"$namespace\"})", "legendFormat": "Rebalancing", "refId": "A"}],
      "title": "Shards Rebalancing",
      "type": "stat"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["fen", "data-nodes"],
  "templating": {
    "list": [
      {"current": {}, "hide": 0, "label": "Data Source", "name": "datasource", "query": "prometheus", "refresh": 1, "type": "datasource"},
      {"current": {}, "datasource": {"type": "prometheus", "uid": "${datasource}"}, "definition": "label_values(up{job=~\"fen-.*\"}, namespace)", "hide": 0, "label": "Namespace", "name": "namespace", "query": {"query": "label_values(up{job=~\"fen-.*\"}, namespace)"}, "refresh": 1, "type": "query"}
    ]
  },
  "time": {"from": "now-6h", "to": "now"},
