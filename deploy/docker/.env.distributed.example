# Fen Distributed Mode - Environment Configuration
# Copy to .env.distributed and customize for local development
#
# Usage:
#   cp .env.distributed.example .env.distributed
#   docker-compose -f docker-compose.distributed.yml --env-file .env.distributed up -d

# =============================================================================
# Database Passwords
# =============================================================================
POSTGRES_PASSWORD=fen_dev_password
TIMESCALE_PASSWORD=fen_metrics_password

# =============================================================================
# JWT & Authentication
# =============================================================================
# JWT secret for token signing (CHANGE IN PRODUCTION!)
JWT_SECRET=local-dev-jwt-secret-change-in-production

# Disable auth for local development (set to true for auth testing)
REQUIRE_AUTH=false

# =============================================================================
# Kafka Configuration
# =============================================================================
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# =============================================================================
# Cluster Configuration
# =============================================================================
# Number of shards (for local dev, keep at 2)
NUM_SHARDS=2

# Replication factor (for local dev with single data nodes per shard)
REPLICATION_FACTOR=1

# =============================================================================
# Logging
# =============================================================================
# Rust log levels (comma-separated filters)
# Options: error, warn, info, debug, trace
# Format: module=level
RUST_LOG=info,fen_api=debug,fen_ingestion=debug,fen_rules=debug,fen_coordinator=debug,fen_data=debug

# =============================================================================
# Resource Limits (optional - for constrained environments)
# =============================================================================
# Uncomment to set memory limits
# KAFKA_HEAP_OPTS=-Xmx512m -Xms512m
# COORDINATOR_MEMORY_LIMIT=512m
# DATA_NODE_MEMORY_LIMIT=1g
# API_MEMORY_LIMIT=512m
