# Fen API Authentication Configuration
# Copy this file to .env and adjust values as needed

# =============================================================================
# JWT Configuration
# =============================================================================

# Secret key for signing JWT tokens (CHANGE IN PRODUCTION!)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Whether authentication is required for all endpoints
# Set to "false" for development/testing without auth
REQUIRE_AUTH=true

# =============================================================================
# OIDC/Keycloak Configuration
# =============================================================================

# OIDC Issuer URL (Keycloak realm URL)
# For local development with docker-compose:
OIDC_ISSUER_URL=http://localhost:8080/realms/fen

# Client ID registered in Keycloak
OIDC_CLIENT_ID=fen-api

# Client secret (for confidential clients)
OIDC_CLIENT_SECRET=fen-api-secret

# Redirect URI after successful authentication
OIDC_REDIRECT_URI=http://localhost:3000/auth/callback

# OAuth2 scopes to request (comma-separated)
OIDC_SCOPES=openid,profile,email

# =============================================================================
# Test Users (configured in Keycloak)
# =============================================================================
#
